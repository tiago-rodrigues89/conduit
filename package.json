{
  "name": "conduit",
  "version": "1.9.0",
  "description": "A modern SSH & SFTP client for macOS",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n ui,app -c magenta,cyan \"vite --port 5199 --strictPort\" \"wait-on tcp:127.0.0.1:5199 && CONDUIT_DEV_URL=http://127.0.0.1:5199 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit -p .",
    "icon": "electron scripts/make-icon.js",
    "dist": "vite build && node scripts/dist.js",
    "install-app": "npm run dist && rm -rf /Applications/Conduit.app && cp -R release/mac-arm64/Conduit.app /Applications/"
  },
  "author": "Tiago",
  "license": "UNLICENSED",
  "dependencies": {
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.6",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": true,
    "electron-winstaller": false
  },
  "productName": "Conduit",
  "private": true,
  "build": {
    "appId": "dev.tiago.conduit",
    "productName": "Conduit",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/node-pty/prebuilds/win32-*/**",
      "!node_modules/node-pty/third_party/**",
      "!node_modules/node-pty/src/**",
      "!node_modules/node-pty/deps/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "darkModeSupport": true,
      "extendInfo": {
        "NSRequiresAquaSystemAppearance": false
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "npmRebuild": false,
    "dmg": {
      "title": "Conduit",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}